# Caddy: HTTPS (automatic Let's Encrypt certificate for $DOMAIN) + routing.
# Used by docker-compose.prod.yml.

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# API and health endpoints -> FastAPI backend
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /health {
		reverse_proxy backend:8000
	}
	handle /ready {
		reverse_proxy backend:8000
	}

	# Everything else -> React app (nginx serves index.html for app routes)
	handle {
		reverse_proxy frontend:8080
	}
}
