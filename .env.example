# ---- BalanceVault backend configuration ----
# Used by the API and by docker-compose.yml.

# PostgreSQL. With Docker, the postgres container is created with this user/password
# and published on DB_PORT on your machine. Host defaults to localhost.
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=
DB_NAME=balancevault
# DB_HOST=localhost
# DB_SSLMODE=require          # for hosted databases that require SSL

# Hosted database (e.g. Neon): paste the full connection string instead of the DB_* values above.
# postgresql://... is accepted as-is (the app switches it to its psycopg driver).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Redis port on your machine. Leave empty to use in-memory rate limiting.
REDIS_PORT=6379
# REDIS_HOST=localhost

# Frontend URL(s) allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173

# Long random value, at least 32 characters.
JWT_SECRET=

ENVIRONMENT=development
COOKIE_SECURE=false

# First admin, created on start if missing. Signs in with the username (or the email).
# Minimum 8 characters; a weak password is allowed here but prints a warning.
BV_ADMIN_USERNAME=admin
BV_ADMIN_EMAIL=admin@example.com
BV_ADMIN_NAME=Vault Admin
BV_ADMIN_PASSWORD=

# Forgot password: reset links point to this frontend URL.
FRONTEND_URL=http://localhost:5173
# Optional SMTP to email reset links. If SMTP_HOST is empty, the link is printed in the
# backend log instead (docker compose logs backend).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=BalanceVault <no-reply@example.com>

# Port of the API on your machine (Docker).
# BACKEND_PORT=8000

# ---- Production server only (docker-compose.prod.yml) ----
# Public domain name pointing at the server, e.g. balancevault.duckdns.org (no https://).
# DOMAIN=
